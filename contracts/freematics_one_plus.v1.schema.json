{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autocare.local/contracts/freematics_one_plus.v1.schema.json",
  "title": "AutoCare device payload contract v1 (ADR-006)",
  "description": "Generated from backend/app/gateway/contract.py. Do not edit by hand.",
  "oneOf": [
    {
      "$ref": "#/$defs/BatchV1"
    },
    {
      "$ref": "#/$defs/CriticalV1"
    },
    {
      "$ref": "#/$defs/AckV1"
    }
  ],
  "$defs": {
    "AckV1": {
      "additionalProperties": false,
      "properties": {
        "ok": {
          "default": true,
          "title": "Ok",
          "type": "boolean"
        },
        "dup": {
          "default": false,
          "description": "This batch key was already stored",
          "title": "Dup",
          "type": "boolean"
        },
        "server_time": {
          "description": "Lets the device correct its clock",
          "minimum": 0,
          "title": "Server Time",
          "type": "integer"
        },
        "cmds": {
          "items": {
            "$ref": "#/$defs/Command"
          },
          "title": "Cmds",
          "type": "array"
        }
      },
      "required": [
        "server_time"
      ],
      "title": "AckV1",
      "type": "object"
    },
    "BatchV1": {
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1,
          "title": "V",
          "type": "integer"
        },
        "device_id": {
          "examples": [
            "FM1-0001"
          ],
          "pattern": "^[A-Z0-9][A-Z0-9-]{2,31}$",
          "title": "Device Id",
          "type": "string"
        },
        "fw": {
          "maxLength": 32,
          "title": "Fw",
          "type": "string"
        },
        "boot": {
          "description": "Boot counter, persisted on the device",
          "minimum": 0,
          "title": "Boot",
          "type": "integer"
        },
        "trip": {
          "description": "Trip counter, persisted on the device",
          "minimum": 0,
          "title": "Trip",
          "type": "integer"
        },
        "seq": {
          "description": "Batch number within the trip, from 0",
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "final": {
          "default": false,
          "description": "Last batch of the trip",
          "title": "Final",
          "type": "boolean"
        },
        "t0": {
          "description": "Base time of this batch, device clock",
          "minimum": 0,
          "title": "T0",
          "type": "integer"
        },
        "sent_at": {
          "description": "Device clock when this upload was attempted",
          "minimum": 0,
          "title": "Sent At",
          "type": "integer"
        },
        "gnss_time": {
          "anyOf": [
            {
              "description": "Unix time in milliseconds",
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "GNSS time at sent_at, if the device has a fix",
          "title": "Gnss Time"
        },
        "s": {
          "patternProperties": {
            "^[a-z][a-z0-9_]{0,31}$": {
              "items": {
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "maximum": 21600000,
                    "minimum": 0,
                    "type": "integer"
                  },
                  {
                    "type": "number"
                  }
                ],
                "type": "array"
              },
              "type": "array"
            }
          },
          "title": "S",
          "type": "object"
        },
        "g": {
          "description": "[dt_ms, lat, lon, speed_kmh] fixes",
          "items": {
            "maxItems": 4,
            "minItems": 4,
            "prefixItems": [
              {
                "maximum": 21600000,
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "title": "G",
          "type": "array"
        },
        "ev": {
          "items": {
            "anyOf": [
              {
                "discriminator": {
                  "mapping": {
                    "cmd_result": "#/$defs/CommandResult",
                    "crank": "#/$defs/CrankEvent",
                    "dtc": "#/$defs/DtcEvent",
                    "freeze_frame": "#/$defs/FreezeFrame",
                    "harsh": "#/$defs/HarshEvent",
                    "mode06": "#/$defs/Mode06Event",
                    "pids_supported": "#/$defs/PidsSupported",
                    "readiness": "#/$defs/Readiness",
                    "trip_end": "#/$defs/TripEnd",
                    "trip_start": "#/$defs/TripStart",
                    "vin": "#/$defs/VinEvent"
                  },
                  "propertyName": "type"
                },
                "oneOf": [
                  {
                    "$ref": "#/$defs/TripStart"
                  },
                  {
                    "$ref": "#/$defs/TripEnd"
                  },
                  {
                    "$ref": "#/$defs/VinEvent"
                  },
                  {
                    "$ref": "#/$defs/PidsSupported"
                  },
                  {
                    "$ref": "#/$defs/Readiness"
                  },
                  {
                    "$ref": "#/$defs/DtcEvent"
                  },
                  {
                    "$ref": "#/$defs/FreezeFrame"
                  },
                  {
                    "$ref": "#/$defs/Mode06Event"
                  },
                  {
                    "$ref": "#/$defs/CrankEvent"
                  },
                  {
                    "$ref": "#/$defs/HarshEvent"
                  },
                  {
                    "$ref": "#/$defs/CommandResult"
                  }
                ]
              },
              {
                "$ref": "#/$defs/UnknownEvent"
              }
            ]
          },
          "title": "Ev",
          "type": "array"
        },
        "net": {
          "$ref": "#/$defs/Network"
        }
      },
      "required": [
        "v",
        "device_id",
        "fw",
        "boot",
        "trip",
        "seq",
        "t0",
        "sent_at"
      ],
      "title": "BatchV1",
      "type": "object"
    },
    "Command": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "integer"
        },
        "type": {
          "enum": [
            "health_scan",
            "set_poll_rates"
          ],
          "title": "Type",
          "type": "string"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "title": "Command",
      "type": "object"
    },
    "CommandResult": {
      "additionalProperties": false,
      "properties": {
        "t": {
          "description": "ms after the batch's t0",
          "maximum": 21600000,
          "minimum": 0,
          "title": "T",
          "type": "integer"
        },
        "type": {
          "const": "cmd_result",
          "title": "Type",
          "type": "string"
        },
        "command_id": {
          "title": "Command Id",
          "type": "integer"
        },
        "status": {
          "enum": [
            "done",
            "failed",
            "unsupported"
          ],
          "title": "Status",
          "type": "string"
        },
        "detail": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        }
      },
      "required": [
        "t",
        "type",
        "command_id",
        "status"
      ],
      "title": "CommandResult",
      "type": "object"
    },
    "CrankEvent": {
      "additionalProperties": false,
      "properties": {
        "t": {
          "description": "ms after the batch's t0",
          "maximum": 21600000,
          "minimum": 0,
          "title": "T",
          "type": "integer"
        },
        "type": {
          "const": "crank",
          "title": "Type",
          "type": "string"
        },
        "rate_hz": {
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "title": "Rate Hz",
          "type": "number"
        },
        "volts": {
          "description": "Battery volts at rate_hz",
          "items": {
            "type": "number"
          },
          "maxItems": 4096,
          "title": "Volts",
          "type": "array"
        }
      },
      "required": [
        "t",
        "type",
        "rate_hz",
        "volts"
      ],
      "title": "CrankEvent",
      "type": "object"
    },
    "CriticalV1": {
      "additionalProperties": false,
      "description": "Small, sent immediately (not batched) when the device sees a Stop-safely condition.",
      "properties": {
        "v": {
          "const": 1,
          "title": "V",
          "type": "integer"
        },
        "device_id": {
          "examples": [
            "FM1-0001"
          ],
          "pattern": "^[A-Z0-9][A-Z0-9-]{2,31}$",
          "title": "Device Id",
          "type": "string"
        },
        "boot": {
          "minimum": 0,
          "title": "Boot",
          "type": "integer"
        },
        "trip": {
          "minimum": 0,
          "title": "Trip",
          "type": "integer"
        },
        "t": {
          "description": "Device clock when the condition was detected",
          "minimum": 0,
          "title": "T",
          "type": "integer"
        },
        "sent_at": {
          "description": "Unix time in milliseconds",
          "minimum": 0,
          "title": "Sent At",
          "type": "integer"
        },
        "kind": {
          "enum": [
            "coolant_high",
            "voltage_collapse",
            "misfire_severe",
            "other"
          ],
          "title": "Kind",
          "type": "string"
        },
        "values": {
          "maxProperties": 16,
          "patternProperties": {
            "^[a-z][a-z0-9_]{0,31}$": {
              "type": "number"
            }
          },
          "title": "Values",
          "type": "object"
        },
        "pos": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "[lat, lon] if consented",
          "title": "Pos"
        }
      },
      "required": [
        "v",
        "device_id",
        "boot",
        "trip",
        "t",
        "sent_at",
        "kind",
        "values"
      ],
      "title": "CriticalV1",
      "type": "object"
    },
    "DtcEvent": {
      "additionalProperties": false,
      "properties": {
        "t": {
          "description": "ms after the batch's t0",
          "maximum": 21600000,
          "minimum": 0,
          "title": "T",
          "type": "integer"
        },
        "type": {
          "const": "dtc",
          "title": "Type",
          "type": "string"
        },
        "mode": {
          "description": "03 stored, 07 pending, 0A permanent",
          "enum": [
            "03",
            "07",
            "0A"
          ],
          "title": "Mode",
          "type": "string"
        },
        "codes": {
          "items": {
            "examples": [
              "P0128"
            ],
            "pattern": "^[PCBU][0-9A-F]{4}$",
            "type": "string"
          },
          "maxItems": 64,
          "title": "Codes",
          "type": "array"
        }
      },
      "required": [
        "t",
        "type",
        "mode",
        "codes"
      ],
      "title": "DtcEvent",
      "type": "object"
    },
    "FreezeFrame": {
      "additionalProperties": false,
      "properties": {
        "t": {
          "description": "ms after the batch's t0",
          "maximum": 21600000,
          "minimum": 0,
          "title": "T",
          "type": "integer"
        },
        "type": {
          "const": "freeze_frame",
          "title": "Type",
          "type": "string"
        },
        "code": {
          "examples": [
            "P0128"
          ],
          "pattern": "^[PCBU][0-9A-F]{4}$",
          "title": "Code",
          "type": "string"
        },
        "values": {
          "patternProperties": {
            "^[a-z][a-z0-9_]{0,31}$": {
              "type": "number"
            }
          },
          "title": "Values",
          "type": "object"
        }
      },
      "required": [
        "t",
        "type",
        "code",
        "values"
      ],
      "title": "FreezeFrame",
      "type": "object"
    },
    "HarshEvent": {
      "additionalProperties": false,
      "properties": {
        "t": {
          "description": "ms after the batch's t0",
          "maximum": 21600000,
          "minimum": 0,
          "title": "T",
          "type": "integer"
        },
        "type": {
          "const": "harsh",
          "title": "Type",
          "type": "string"
        },
        "kind": {
          "enum": [
            "brake",
            "accel",
            "corner"
          ],
          "title": "Kind",
          "type": "string"
        },
        "peak_g": {
          "maximum": 16,
          "minimum": 0,
          "title": "Peak G",
          "type": "number"
        }
      },
      "required": [
        "t",
        "type",
        "kind",
        "peak_g"
      ],
      "title": "HarshEvent",
      "type": "object"
    },
    "Mode06Event": {
      "additionalProperties": false,
      "properties": {
        "t": {
          "description": "ms after the batch's t0",
          "maximum": 21600000,
          "minimum": 0,
          "title": "T",
          "type": "integer"
        },
        "type": {
          "const": "mode06",
          "title": "Type",
          "type": "string"
        },
        "results": {
          "items": {
            "$ref": "#/$defs/Mode06Result"
          },
          "maxItems": 512,
          "title": "Results",
          "type": "array"
        }
      },
      "required": [
        "t",
        "type",
        "results"
      ],
      "title": "Mode06Event",
      "type": "object"
    },
    "Mode06Result": {
      "additionalProperties": false,
      "properties": {
        "mid": {
          "maximum": 255,
          "minimum": 0,
          "title": "Mid",
          "type": "integer"
        },
        "tid": {
          "maximum": 255,
          "minimum": 0,
          "title": "Tid",
          "type": "integer"
        },
        "uasid": {
          "description": "Unit and scaling id (raw values below)",
          "maximum": 255,
          "minimum": 0,
          "title": "Uasid",
          "type": "integer"
        },
        "value": {
          "title": "Value",
          "type": "integer"
        },
        "min": {
          "title": "Min",
          "type": "integer"
        },
        "max": {
          "title": "Max",
          "type": "integer"
        }
      },
      "required": [
        "mid",
        "tid",
        "uasid",
        "value",
        "min",
        "max"
      ],
      "title": "Mode06Result",
      "type": "object"
    },
    "Network": {
      "additionalProperties": false,
      "properties": {
        "rssi": {
          "anyOf": [
            {
              "maximum": 0,
              "minimum": -150,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "dBm",
          "title": "Rssi"
        },
        "bytes_up": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Bytes uploaded since boot",
          "title": "Bytes Up"
        },
        "iccid": {
          "anyOf": [
            {
              "pattern": "^[0-9]{18,22}F?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Iccid"
        }
      },
      "title": "Network",
      "type": "object"
    },
    "PidsSupported": {
      "additionalProperties": false,
      "properties": {
        "t": {
          "description": "ms after the batch's t0",
          "maximum": 21600000,
          "minimum": 0,
          "title": "T",
          "type": "integer"
        },
        "type": {
          "const": "pids_supported",
          "title": "Type",
          "type": "string"
        },
        "protocol": {
          "examples": [
            "ISO 15765-4 CAN 11/500"
          ],
          "maxLength": 32,
          "title": "Protocol",
          "type": "string"
        },
        "mode01": {
          "description": "Concatenated Mode 01 support bitmaps (PIDs 00, 20, 40, ...) as hex",
          "pattern": "^[0-9A-F]{8,64}$",
          "title": "Mode01",
          "type": "string"
        }
      },
      "required": [
        "t",
        "type",
        "protocol",
        "mode01"
      ],
      "title": "PidsSupported",
      "type": "object"
    },
    "Readiness": {
      "additionalProperties": false,
      "properties": {
        "t": {
          "description": "ms after the batch's t0",
          "maximum": 21600000,
          "minimum": 0,
          "title": "T",
          "type": "integer"
        },
        "type": {
          "const": "readiness",
          "title": "Type",
          "type": "string"
        },
        "mil": {
          "title": "Mil",
          "type": "boolean"
        },
        "dtc_count": {
          "maximum": 127,
          "minimum": 0,
          "title": "Dtc Count",
          "type": "integer"
        },
        "monitors": {
          "additionalProperties": {
            "enum": [
              "complete",
              "incomplete",
              "na"
            ],
            "type": "string"
          },
          "description": "Monitor name -> state, from Mode 01 PID 01",
          "title": "Monitors",
          "type": "object"
        }
      },
      "required": [
        "t",
        "type",
        "mil",
        "dtc_count",
        "monitors"
      ],
      "title": "Readiness",
      "type": "object"
    },
    "TripEnd": {
      "additionalProperties": false,
      "properties": {
        "t": {
          "description": "ms after the batch's t0",
          "maximum": 21600000,
          "minimum": 0,
          "title": "T",
          "type": "integer"
        },
        "type": {
          "const": "trip_end",
          "title": "Type",
          "type": "string"
        },
        "reason": {
          "default": "ignition_off",
          "enum": [
            "ignition_off",
            "idle_timeout",
            "power_loss",
            "other"
          ],
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "t",
        "type"
      ],
      "title": "TripEnd",
      "type": "object"
    },
    "TripStart": {
      "additionalProperties": false,
      "properties": {
        "t": {
          "description": "ms after the batch's t0",
          "maximum": 21600000,
          "minimum": 0,
          "title": "T",
          "type": "integer"
        },
        "type": {
          "const": "trip_start",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "t",
        "type"
      ],
      "title": "TripStart",
      "type": "object"
    },
    "UnknownEvent": {
      "additionalProperties": true,
      "description": "Event types newer than this server: kept out of the way, never a rejection.",
      "properties": {
        "t": {
          "maximum": 21600000,
          "minimum": 0,
          "title": "T",
          "type": "integer"
        },
        "type": {
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "t",
        "type"
      ],
      "title": "UnknownEvent",
      "type": "object"
    },
    "VinEvent": {
      "additionalProperties": false,
      "properties": {
        "t": {
          "description": "ms after the batch's t0",
          "maximum": 21600000,
          "minimum": 0,
          "title": "T",
          "type": "integer"
        },
        "type": {
          "const": "vin",
          "title": "Type",
          "type": "string"
        },
        "vin": {
          "maxLength": 17,
          "minLength": 11,
          "title": "Vin",
          "type": "string"
        }
      },
      "required": [
        "t",
        "type",
        "vin"
      ],
      "title": "VinEvent",
      "type": "object"
    }
  }
}
