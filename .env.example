# Copy to .env and fill in. Never commit .env.

# --- App ---
APP_NAME=AutoCare
ENVIRONMENT=development          # development | production
LOG_LEVEL=INFO
TIMEZONE=Africa/Lagos

# --- Database (one Postgres; also hosts the job queue, ADR-003/004) ---
DATABASE_URL=postgresql+asyncpg://autocare:autocare@localhost:5432/autocare

# --- Auth ---
JWT_SECRET=change-me
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=30

# --- CORS (web app origins, comma-separated) ---
CORS_ORIGINS=http://localhost:3000

# --- ML / datasets (outside the repo; never committed) ---
# Windows example: C:\Users\Godswisdom\Downloads\datasets
DATASETS_DIR=

# --- Later phases (leave empty until the phase that needs them) ---
# LLM via LiteLLM (Phase 4)
LLM_MODEL=
LLM_API_KEY=
# Web push VAPID keys (Phase 6)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Email (Phase 6)
EMAIL_FROM=
EMAIL_API_KEY=
