    {
      "name": "09 Refresh (rotates tokens) -> 200",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base}}/auth/refresh",
        "description": "Expect HTTP 200. Then save: token = response.access_token, refresh = response.refresh_token. Save the old refresh token as old_refresh before running.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refresh_token\": \"{{refresh}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "10 Refresh with the OLD token (reuse) -> 401",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base}}/auth/refresh",
        "description": "Expect HTTP 401. Reuse revokes all A's sessions; log in again next.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refresh_token\": \"{{old_refresh}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
